# Copie para .env e preencha os valores reais (nunca commite .env)
# DATABASE_URL é obrigatória — Postgres local ou Render
DATABASE_URL=postgres://orbital_leads:senha@localhost:5432/orbital_leads

# Segredo JWT — gere com: openssl rand -base64 32
JWT_SECRET=troque-por-um-segredo-com-32+-caracteres-aleatorios

# Google Maps — Places API ativada, restrita ao servidor
GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Opcionais
NODE_ENV=development
PORT=3000
VITE_APP_ID=orbital-leads-crm

# Admin — conta administradora garantida no arranque (cota ilimitada + painel admin)
ADMIN_EMAIL=voce@empresa.com
# ADMIN_PASSWORD=troque-por-senha-forte (só usada para CRIAR o admin se não existir)

# Anti-abuso: máximo de contas criadas pelo site por IP (admin não conta)
FREE_PER_IP_LIMIT=2

# Google OAuth (botão "Entrar com Google" no login)
GOOGLE_OAUTH_CLIENT_ID=

# Cakto — pagamentos (https://docs.cakto.com.br/introduction)
# Secret do webhook (gerado ao criar o webhook no painel Cakto)
CAKTO_WEBHOOK_SECRET=
# Ids das ofertas (uma por plano) para mapear compra -> plano
CAKTO_OFFER_START=
CAKTO_OFFER_PLUS=
CAKTO_OFFER_SCALE=
# Links de checkout (um por plano); a venda usa ?callback=token + redirect {{callback}}
CAKTO_CHECKOUT_START=
CAKTO_CHECKOUT_PLUS=
CAKTO_CHECKOUT_SCALE=
